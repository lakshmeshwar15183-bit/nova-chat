# ---- Application ----
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://novachat:novachat@localhost:5432/novachat?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Two-factor authentication (TOTP) ----
# Key used to encrypt TOTP secrets at rest (AES-256-GCM). Falls back to
# JWT_ACCESS_SECRET if unset; set a dedicated value in production.
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_ISSUER=NovaChat

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- Email / SMTP (optional; logs OTP to console if unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NovaChat <no-reply@novachat.dev>

# ---- Supabase Storage (optional; falls back to local ./uploads) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=novachat-media

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=120
